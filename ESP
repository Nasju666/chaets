
--[[
    AUTO PLAYER ESP
    Updated Chams ESP

    Features:
    - Automatically detects existing players
    - Instantly detects new players
    - Reapplies ESP when players respawn
    - Removes ESP when players leave
    - Team checking
    - Team colors
    - Always On Top / Through Walls
    - Custom fill and outline colors
    - Custom transparency
    - Draggable GUI
    - RightShift to show/hide GUI
]]

-- SERVICES
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- SETTINGS
local Settings = {
    Enabled = true,
    TeamCheck = false,
    TeamColor = false,
    AlwaysShow = true,

    OutlineColor = Color3.fromRGB(255, 255, 255),
    OutlineTransparency = 0,

    FillColor = Color3.fromRGB(0, 100, 100),
    FillTransparency = 0.5
}

-- CLEAN OLD GUI AND STORAGE
local oldGui = PlayerGui:FindFirstChild("AutoESP_GUI")
if oldGui then
    oldGui:Destroy()
end

local oldStorage = workspace:FindFirstChild("AutoESP_Storage")
if oldStorage then
    oldStorage:Destroy()
end

-- ESP STORAGE
local Storage = Instance.new("Folder")
Storage.Name = "AutoESP_Storage"
Storage.Parent = workspace

local TrackedPlayers = {}

-- UPDATE PLAYER ESP
local function updateESP(player)
    local data = TrackedPlayers[player]
    if not data then
        return
    end

    local highlight = data.Highlight
    local character = data.Character

    local enabled = Settings.Enabled and character ~= nil

    -- Team filtering
    if Settings.TeamCheck and LocalPlayer.Team ~= nil then
        if player.Team == LocalPlayer.Team then
            enabled = false
        end
    end

    -- Health checking
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")

        if humanoid and humanoid.Health <= 0 then
            enabled = false
        end
    end

    highlight.Enabled = enabled

    -- Through walls
    if Settings.AlwaysShow then
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    else
        highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    end

    -- Team color or custom color
    if Settings.TeamColor then
        highlight.OutlineColor = player.TeamColor.Color
    else
        highlight.OutlineColor = Settings.OutlineColor
    end

    highlight.FillColor = Settings.FillColor
    highlight.FillTransparency = Settings.FillTransparency
    highlight.OutlineTransparency = Settings.OutlineTransparency
end

-- UPDATE ALL PLAYERS
local function updateAllESP()
    for player in pairs(TrackedPlayers) do
        updateESP(player)
    end
end

-- ATTACH ESP TO CHARACTER
local function attachCharacter(player, character)
    local data = TrackedPlayers[player]
    if not data then
        return
    end

    -- Disconnect previous health listener
    if data.HealthConnection then
        data.HealthConnection:Disconnect()
        data.HealthConnection = nil
    end

    data.Character = character
    data.Highlight.Adornee = character

    updateESP(player)

    -- Monitor health after character loads
    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10)

        if not humanoid then
            return
        end

        if TrackedPlayers[player] ~= data then
            return
        end

        if data.Character ~= character then
            return
        end

        data.HealthConnection = humanoid.HealthChanged:Connect(function()
            updateESP(player)
        end)

        updateESP(player)
    end)
end

-- REGISTER PLAYER
local function addPlayer(player)
    -- Ignore local player
    if player == LocalPlayer then
        return
    end

    -- Prevent duplicate tracking
    if TrackedPlayers[player] then
        return
    end

    -- Create highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_" .. player.Name
    highlight.Enabled = false
    highlight.FillColor = Settings.FillColor
    highlight.OutlineColor = Settings.OutlineColor
    highlight.FillTransparency = Settings.FillTransparency
    highlight.OutlineTransparency = Settings.OutlineTransparency
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = Storage

    local data = {
        Highlight = highlight,
        Character = nil,
        Connections = {},
        HealthConnection = nil
    }

    TrackedPlayers[player] = data

    -- Detect respawning
    table.insert(
        data.Connections,
        player.CharacterAdded:Connect(function(character)
            attachCharacter(player, character)
        end)
    )

    -- Detect character removal
    table.insert(
        data.Connections,
        player.CharacterRemoving:Connect(function(character)
            if data.Character == character then
                data.Character = nil
                data.Highlight.Adornee = nil

                if data.HealthConnection then
                    data.HealthConnection:Disconnect()
                    data.HealthConnection = nil
                end

                updateESP(player)
            end
        end)
    )

    -- Detect team changes
    table.insert(
        data.Connections,
        player:GetPropertyChangedSignal("Team"):Connect(function()
            updateESP(player)
        end)
    )

    -- Attach existing character
    if player.Character then
        attachCharacter(player, player.Character)
    end

    print("[AUTO ESP] Tracking:", player.Name)
end

-- REMOVE PLAYER
local function removePlayer(player)
    local data = TrackedPlayers[player]
    if not data then
        return
    end

    -- Disconnect events
    for _, connection in ipairs(data.Connections) do
        connection:Disconnect()
    end

    if data.HealthConnection then
        data.HealthConnection:Disconnect()
    end

    -- Destroy highlight
    if data.Highlight then
        data.Highlight:Destroy()
    end

    TrackedPlayers[player] = nil

    print("[AUTO ESP] Removed:", player.Name)
end

-- DETECT EXISTING PLAYERS
for _, player in ipairs(Players:GetPlayers()) do
    addPlayer(player)
end

-- DETECT NEW PLAYERS INSTANTLY
Players.PlayerAdded:Connect(function(player)
    addPlayer(player)
end)

-- DETECT LEAVING PLAYERS
Players.PlayerRemoving:Connect(function(player)
    removePlayer(player)
end)

-- LOCAL TEAM CHANGES
LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function()
    updateAllESP()
end)

