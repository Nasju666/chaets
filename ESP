-- CREATE TOGGLE
local function createToggle(text, setting)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 30)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.TextColor3 = Color3.new(1, 1, 1)
    button.BorderSizePixel = 0
    button.Parent = Container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = button

    local function refresh()
        local enabled = Settings[setting]

        button.Text = text .. ": " .. (enabled and "ON" or "OFF")

        button.BackgroundColor3 = enabled
            and Color3.fromRGB(25, 115, 75)
            or Color3.fromRGB(65, 65, 70)
    end

    button.MouseButton1Click:Connect(function()
        Settings[setting] = not Settings[setting]

        refresh()
        updateAllESP()
    end)

    refresh()
end

-- CREATE TEXT INPUT
local function createInput(labelText, defaultText, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 30)
    row.BackgroundTransparency = 1
    row.Parent = Container

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.52, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0.48, 0, 1, 0)
    input.Position = UDim2.new(0.52, 0, 0, 0)
    input.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
    input.TextColor3 = Color3.new(1, 1, 1)
    input.Font = Enum.Font.Gotham
    input.TextSize = 12
    input.ClearTextOnFocus = false
    input.Text = defaultText
    input.Parent = row

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = input

    input.FocusLost:Connect(function()
        local success = callback(input.Text)

        if not success then
            input.Text = defaultText
        else
            defaultText = input.Text
            updateAllESP()
        end
    end)
end

-- RGB PARSER
local function parseRGB(text)
    local r, g, b = text:match(
        "^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$"
    )

    if not r then
        return nil
    end

    r = math.clamp(tonumber(r), 0, 255)
    g = math.clamp(tonumber(g), 0, 255)
    b = math.clamp(tonumber(b), 0, 255)

    return Color3.fromRGB(r, g, b)
end

