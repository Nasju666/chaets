    corner.Parent = button

    return button
end

-- =====================================
-- TOGGLE CREATOR
-- =====================================

local function createToggle(label, property)
    local button = createButton()

    local function refresh()
        local enabled = Settings[property]

        button.Text =
            label .. ": "
            .. (enabled and "ON" or "OFF")

        button.BackgroundColor3 = enabled
            and Color3.fromRGB(25, 115, 75)
            or Color3.fromRGB(65, 65, 70)
    end

    button.MouseButton1Click:Connect(function()
        if property == "Enabled" then
            toggleAimbot()
        else
            Settings[property] = not Settings[property]
            clearTarget()
            refresh()
        end
    end)

    refresh()

    -- Allow keyboard hotkeys to refresh GUI
    return refresh
end

-- =====================================
-- INPUT CREATOR
-- =====================================

local function createInput(labelText, initial, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 30)
    row.BackgroundTransparency = 1
    row.Parent = Container

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.52, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextXAlignment =
        Enum.TextXAlignment.Left
    label.Parent = row

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0.48, 0, 1, 0)
    input.Position = UDim2.new(0.52, 0, 0, 0)
    input.BackgroundColor3 =
        Color3.fromRGB(55, 55, 60)
    input.TextColor3 = Color3.new(1, 1, 1)
    input.TextSize = 12
    input.Font = Enum.Font.Gotham
    input.ClearTextOnFocus = false
    input.Text = tostring(initial)
    input.Parent = row

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = input

    input.FocusLost:Connect(function()
        local value = tonumber(input.Text)

        if value then
            callback(value)
        end

        if labelText == "FOV Radius" then
            input.Text = tostring(Settings.Fov)
        else
            input.Text = tostring(Settings.Smoothing)
        end
    end)
end

