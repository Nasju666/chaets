-- =====================================
-- CHARACTER UTILITIES
-- =====================================

local function getBodyPart(character)
    return character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function getLeftArm(character)
    return character:FindFirstChild("LeftUpperArm")
        or character:FindFirstChild("LeftLowerArm")
        or character:FindFirstChild("LeftHand")
        or character:FindFirstChild("Left Arm")
end

local function getRightArm(character)
    return character:FindFirstChild("RightUpperArm")
        or character:FindFirstChild("RightLowerArm")
        or character:FindFirstChild("RightHand")
        or character:FindFirstChild("Right Arm")
end

local function getCandidates(character, mode)
    local candidates = {}

    if not character then
        return candidates
    end

    local function add(modeName, part)
        if part then
            table.insert(candidates, {
                Mode = modeName,
                Part = part
            })
        end
    end

    if mode == "Head" or mode == "Random" then
        add("Head", character:FindFirstChild("Head"))
    end

    if mode == "Body" or mode == "Random" then
        add("Body", getBodyPart(character))
    end

    if mode == "Arms" or mode == "Random" then
        add("Arms", getLeftArm(character))
        add("Arms", getRightArm(character))
    end

    return candidates
end

-- =====================================
-- TARGET VALIDATION
-- =====================================

local function isValidTarget(player)
    if player == LocalPlayer then
        return false
    end

    local character = player.Character

    if not character then
        return false
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    if Settings.TeamCheck
        and LocalPlayer.Team ~= nil
        and player.Team == LocalPlayer.Team then
        return false
    end

    return true
end

-- =====================================
-- WALL CHECK
-- =====================================

local function isVisible(player, part)
    if not Settings.WallCheck then
        return true
    end

    local camera = workspace.CurrentCamera

    if not camera or not part then
        return false
    end

    local origin = camera.CFrame.Position
    local direction = part.Position - origin

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances =
        LocalPlayer.Character
        and {LocalPlayer.Character}
        or {}

    params.IgnoreWater = true

    local result = workspace:Raycast(
        origin,
        direction,
        params
    )

    return result == nil
        or (
            player.Character ~= nil
            and result.Instance:IsDescendantOf(
                player.Character
            )
        )
end

-- =====================================
-- FOV CHECK
-- =====================================

local function isInsideFov(part)
    local camera = workspace.CurrentCamera

    if not camera or not part then
        return false, math.huge
    end

    local screenPos, onScreen =
        camera:WorldToViewportPoint(part.Position)

    if not onScreen then
        return false, math.huge
    end

    local mouse = UIS:GetMouseLocation()

    local distance = (
        Vector2.new(screenPos.X, screenPos.Y)
        - mouse
    ).Magnitude

    return distance <= Settings.Fov, distance
end

-- =====================================
-- TARGET MANAGEMENT
-- =====================================

local function clearTarget()
    LockedPlayer = nil
    LockedPart = nil
end

local function findClosestTarget()
    local closestPlayer = nil
    local closestDistance = Settings.Fov

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidTarget(player) then

            local candidates = getCandidates(
                player.Character,
                Settings.AimMode
            )

            for _, candidate in ipairs(candidates) do
                local part = candidate.Part

                local inside, distance =
                    isInsideFov(part)

                if inside
                    and distance < closestDistance
                    and isVisible(player, part) then

                    closestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end

    return closestPlayer
end

-- =====================================
-- RANDOM HEAD / BODY / ARMS
-- =====================================

local function chooseTargetPart(player)
    if not player or not player.Character then
        return nil
    end

    local candidates = getCandidates(
        player.Character,
        Settings.AimMode
    )

    local available = {}

    for _, candidate in ipairs(candidates) do
        local inside = isInsideFov(candidate.Part)

        if inside
            and isVisible(player, candidate.Part) then

            table.insert(available, candidate)
        end
    end

    if #available == 0 then
        return nil
    end

    -- RANDOM MODE
    if Settings.AimMode == "Random" then
        local availableModes = {}
        local seen = {}

        for _, candidate in ipairs(available) do
            if not seen[candidate.Mode] then
                seen[candidate.Mode] = true

                table.insert(
                    availableModes,
                    candidate.Mode
                )
            end
        end

        local selectedMode = availableModes[
            RNG:NextInteger(1, #availableModes)
        ]

        local modeCandidates = {}

        for _, candidate in ipairs(available) do
            if candidate.Mode == selectedMode then
                table.insert(
                    modeCandidates,
                    candidate.Part
                )
            end
        end

        return modeCandidates[
            RNG:NextInteger(1, #modeCandidates)
        ]
    end

    -- ARMS MODE
    if Settings.AimMode == "Arms" then
        return available[
            RNG:NextInteger(1, #available)
        ].Part
    end

    -- HEAD OR BODY
    return available[1].Part
end

-- =====================================
-- SMOOTH CAMERA AIMING
-- =====================================

local function aimAt(part, dt)
    local camera = workspace.CurrentCamera

    if not camera or not part then
        return
    end

    local current = camera.CFrame

    local desired = CFrame.lookAt(
        current.Position,
        part.Position
    )

    if Settings.Smoothing <= 0 then
        camera.CFrame = desired
        return
    end

    local alpha = 1 - math.exp(
        -Settings.Smoothing * dt
    )

    camera.CFrame = current:Lerp(
        desired,
        math.clamp(alpha, 0, 1)
    )
end

-- =====================================
-- MODE SWITCHING
-- =====================================

local function updateModeButton()
    if ModeButton then
        ModeButton.Text =
            "Aim Mode: "
            .. Settings.AimMode
            .. " [V/B]"
    end
end

local function switchAimMode(direction)
    direction = direction or 1

    local currentIndex =
        table.find(Modes, Settings.AimMode) or 1

    local nextIndex =
        ((currentIndex - 1 + direction) % #Modes) + 1

    Settings.AimMode = Modes[nextIndex]

    clearTarget()
    updateModeButton()

    print("[AIMBOT V7] Mode:", Settings.AimMode)
end

-- =====================================
-- AIMBOT ON/OFF TOGGLE
-- =====================================

local function setAimbotEnabled(enabled)
    Settings.Enabled = enabled

    -- Remove current target on state change
    clearTarget()

    -- Update GUI button
    if refreshAimbotButton then
        refreshAimbotButton()
    end

    print(
        "[AIMBOT V7] Aimbot:",
        Settings.Enabled and "ON" or "OFF"
    )
end

local function toggleAimbot()
    setAimbotEnabled(not Settings.Enabled)
end

-- =====================================
-- REROLL RANDOM PART PER LEFT CLICK
-- =====================================

local function rerollAimPart()
    if not Settings.Enabled then
        return
    end

    if Settings.AimMode ~= "Random" then
        return
    end

    if not UIS:IsMouseButtonPressed(
        Enum.UserInputType.MouseButton2
    ) then
        return
    end

    if not LockedPlayer
        or not isValidTarget(LockedPlayer) then

        clearTarget()
        LockedPlayer = findClosestTarget()
    end

    if not LockedPlayer then
        return
    end

    local newPart = chooseTargetPart(LockedPlayer)

    if newPart then
        LockedPart = newPart

        print(
            "[AIMBOT V7] Random shot:",
            LockedPlayer.Name,
            "| Part:",
            LockedPart.Name
        )
    end
end

