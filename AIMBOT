-- =====================================
-- MAIN AIM LOOP
-- =====================================

RunService:BindToRenderStep(
    "AimbotV7_Update",
    Enum.RenderPriority.Camera.Value + 1,
    function(dt)

        local mouse = UIS:GetMouseLocation()

        FovCircle.Visible = Settings.ShowFov

        FovCircle.Position = UDim2.fromOffset(
            mouse.X,
            mouse.Y
        )

        FovCircle.Size = UDim2.fromOffset(
            Settings.Fov * 2,
            Settings.Fov * 2
        )

        -- Require RMB and enabled state
        local aiming =
            Settings.Enabled
            and UIS:IsMouseButtonPressed(
                Enum.UserInputType.MouseButton2
            )
            and UIS:GetFocusedTextBox() == nil

        if not aiming then
            clearTarget()
            return
        end

        -- Find target
        if not LockedPlayer
            or not isValidTarget(LockedPlayer) then

            clearTarget()
            LockedPlayer = findClosestTarget()

            if LockedPlayer then
                LockedPart = chooseTargetPart(
                    LockedPlayer
                )
            end
        end

        if not LockedPlayer or not LockedPart then
            clearTarget()
            return
        end

        local character = LockedPlayer.Character

        if not character
            or not LockedPart:IsDescendantOf(character) then

            clearTarget()
            return
        end

        if not isVisible(LockedPlayer, LockedPart) then
            clearTarget()
            return
        end

        aimAt(LockedPart, dt)
    end
)

Players.PlayerRemoving:Connect(function(player)
    if player == LockedPlayer then
        clearTarget()
    end
end)

